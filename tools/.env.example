# Copy to tools/.env (gitignored) and fill in. Comma-separate several keys per provider;
# the pipeline rotates to the next key when one is rate-limited or out of quota.
GEMINI_API_KEYS=key1,key2
OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...
# Optional, paid (prepaid credits at console.anthropic.com). Leave empty to never use Claude.
ANTHROPIC_API_KEY=
